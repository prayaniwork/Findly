# Findly Backend Environment Variables Template (.env.example)
# DO NOT put real secrets here! Put real secrets in .env.local
NODE_ENV=development
PORT=3000

# 1. SerpAPI (Google Lens & Google Shopping Visual Search)
SERPAPI_API_KEY=your-serpapi-key-here

# 2. Commerce API Proxy (Optional)
COMMERCE_API_URL=https://serpapi.com/search.json
COMMERCE_API_KEY=your-api-key-here
COMMERCE_API_KEY_HEADER=api_key

# 3. Supabase Integration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 4. Vision AI Models (Optional)
GOOGLE_VISION_API_KEY=
OPENAI_API_KEY=
